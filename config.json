{
  "input_device": "CABLE Output",
  "fallback_to_speaker_loopback": true,

  "skip_languages": ["en"],
  "skip_threshold": 0.25,
  "min_language_prob": 0.5,
  "text_translation": ["zh", "yue"],
  "chinese_asr": "whisper",
  "mt_threads": 2,
  "game_glossary": true,
  "lid_backend": "whisper",
  "lid_confidence": 0.5,
  "lid_threads": 2,

  "model": "small",
  "backend": "whisper.cpp",
  "whispercpp_quant": "q8_0",
  "whispercpp_min_ctx": 256,
  "device": "cpu",
  "compute_type": "int8",
  "cpu_threads": 4,
  "process_priority": "below_normal",
  "cpu_affinity": "off",

  "vad_backend": "silero",
  "vad_speech_threshold": 0.5,
  "vad_silence_ms": 450,
  "vad_adaptive": true,
  "vad_fast_silence_ms": 250,
  "vad_slow_silence_ms": 700,
  "vad_merge_gap_ms": 300,
  "vad_max_segment_s": 7,
  "vad_min_speech_ms": 400,
  "vad_threshold_db": -45,

  "voice_enabled": false,
  "voice_rate": 200,
  "voice_volume": 0.8,

  "overlay_enabled": true,
  "overlay_font_size": 20,
  "overlay_seconds": 6,
  "overlay_bottom_offset": 160,
  "overlay_opacity": 0.85,

  "history_size": 50,

  "hotkey_toggle": "ctrl+alt+t",
  "hotkey_voice": "ctrl+alt+v",
  "hotkey_replay": "ctrl+alt+r",
  "hotkey_quit": "ctrl+alt+q",
  "hotkey_history": "ctrl+alt+h"
}
